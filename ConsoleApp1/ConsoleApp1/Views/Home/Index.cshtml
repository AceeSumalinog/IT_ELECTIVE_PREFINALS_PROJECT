@{
    ViewData["Title"] = "Student List";
}
@model List<IT_ELECTIVE_PREFINALS_PROJECT.Models.Student>

<div class="custom-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 style="color: var(--dark-teal); font-weight: bold;">📋 Student Directory</h3>
        <a href="/Student/Create" class="btn btn-teal">+ Add New Student</a>
    </div>

    <table class="table table-hover table-teal align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Course</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No records found. Click "Add New Student" to get started.</td>
                </tr>
            }
            else
            {
                @foreach (var student in Model)
                {
                    <tr>
                        <td><strong>@student.Id</strong></td>
                        <td>@student.Name</td>
                        <td><span class="badge" style="background-color: var(--soft-teal); color: #000;">@student.Course</span></td>
                        <td class="text-center">
                            <a href="/Student/Delete/@student.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this record?');">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>