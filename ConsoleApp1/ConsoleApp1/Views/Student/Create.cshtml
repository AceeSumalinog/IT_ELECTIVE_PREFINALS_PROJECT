@{
    ViewData["Title"] = "Add Student";
}
@model IT_ELECTIVE_PREFINALS_PROJECT.Models.Student

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="custom-card">
            <h3 class="mb-4" style="color: var(--dark-teal); font-weight: bold;">➕ Add New Student</h3>

            <form action="/Student/Create" method="post">
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Student ID</label>
                    <input type="number" name="Id" class="form-control" placeholder="e.g. 20261001" required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Full Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Justine Villarino" required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Course</label>
                    <input type="text" name="Course" class="form-control" placeholder="e.g. BSIT" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/Student/Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-teal">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>