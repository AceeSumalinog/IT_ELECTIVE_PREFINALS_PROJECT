@model List<IT_ELECTIVE_PREFINALS_PROJECT.Models.Student>

<h2>Student List</h2>

<a href="/Student/Create" class="btn btn-primary mb-3">Add New Student</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Course</td>
                <td>
                    <a href="/Student/Delete/@student.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>